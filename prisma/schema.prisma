// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WhatsAppConfig {
  id                String   @id @default(uuid())
  shop              String   @unique
  selectedCountryIso String  @default("IN")
  phoneNumber       String   @default("91")
  message           String   @default("")
  displayStyle      String   @default("icon_only")
  buttonText        String   @default("Chat with us")
  animation         String   @default("pulse")
  useCustomLink     Boolean  @default(false)
  customUrl         String   @default("")
  iconWidth         String   @default("28")
  iconHeight        String   @default("28")
  transparentBg     Boolean  @default(false)
  bgColor           String   @default("#25D366")
  textColor         String   @default("#ffffff")
  buttonSize        String   @default("medium")
  horizontalPos     String   @default("right")
  verticalPos       String   @default("bottom")
  rightOffset       Int      @default(20)
  bottomOffset      Int      @default(20)
  visibility        String   @default("always")
  displayDelay      String   @default("0")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
